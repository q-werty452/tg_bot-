# Скопируй этот файл в .env и подставь свои значения.
# Файл .env НИКОГДА не коммить в git и никому не показывать — там секреты.

# --- Обязательно ---
# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456:AA...

# --- Ключи ИИ. Нужен хотя бы один ---
# Ключи легко перепутать, они отличаются началом строки:
#   Anthropic -> sk-ant-...   OpenAI -> sk-proj-... / sk-...   Google -> AIza...
# https://console.anthropic.com/  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-...
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# --- Необязательно (есть значения по умолчанию) ---
# Какой провайдер использовать по умолчанию: claude, openai или gemini
DEFAULT_PROVIDER=claude

# Конкретные модели. Можно менять, не трогая код.
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
# Варианты: gemini-3.6-flash (быстрая), gemini-3.1-pro-preview (умнее, медленнее),
# gemini-flash-latest (всегда свежая flash-модель)
GOOGLE_MODEL=gemini-3.6-flash

# Сколько последних сообщений диалога помнить (пар "вопрос-ответ" примерно вдвое меньше)
HISTORY_LIMIT=20
