# ==========================================================================
#  ОБРАЗЕЦ настроек. Скопируй этот файл в .env и заполни своими значениями.
#  Сам .env содержит секреты — не коммитить и никому не пересылать
#  (он уже добавлен в .gitignore). В этом образце значений быть не должно.
# ==========================================================================

# --- ОБЯЗАТЕЛЬНО: заполни эти три строки ----------------------------------

# Токен бота от @BotFather (вид: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI, https://platform.openai.com/api-keys  (вид: sk-proj-... или sk-...)
OPENAI_API_KEY=

# Ключ Google Gemini, https://aistudio.google.com/apikey  (вид: AIza...)
GOOGLE_API_KEY=


# --- Провайдер по умолчанию -----------------------------------------------
# openai | gemini  (claude — только если добавишь ANTHROPIC_API_KEY ниже)
DEFAULT_PROVIDER=openai


# --- Модели (можно менять, не трогая код) ---------------------------------
OPENAI_MODEL=gpt-4o
# Проверено на этом ключе 20.08.2026: gemini-3.6-flash отвечает стабильно.
# Псевдоним gemini-flash-latest брать НЕ стоит — он периодически перегружен
# (ошибка 503 "high demand") на длинных ответах.
# Модели 2.5 новым пользователям больше не выдаются (404).
# Список моделей, доступных вашему ключу:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=КЛЮЧ"
GOOGLE_MODEL=gemini-3.6-flash


# --- Прочее ---------------------------------------------------------------
# Сколько последних сообщений диалога помнить (это ~10 пар вопрос-ответ)
HISTORY_LIMIT=20

# Таймаут ожидания ответа от ИИ, секунды
REQUEST_TIMEOUT=90

# Уровень логов: INFO (обычно) или DEBUG (при разборе проблем)
LOG_LEVEL=INFO


# --- OpenRouter: один ключ, сотни моделей разных компаний -------------------
# Ключ: https://openrouter.ai/keys (вид: sk-or-v1-...)
# Имена моделей составные: openai/gpt-4o-mini, google/gemini-2.0-flash-exp.
# Удобнее задать ключ и выбрать модель в панели — там покажут список.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- Не используется, включать не нужно -----------------------------------
# Claude (Anthropic). Раскомментируй и впиши ключ, если понадобится третья модель.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- Панель управления (manas-crm) -----------------------------------------
# Адрес панели и служебный токен (тот же, что BOT_API_TOKEN в .env панели).
# Пусто — бот работает автономно, без панели.
CRM_URL=http://127.0.0.1:8000
CRM_BOT_TOKEN=
